# =============================================================================
# Firebird Python Base Image
# =============================================================================
# Builds a minimal Python Debian-slim image with the Firebird 5.x client
# library pre-compiled and installed.  Debian slim uses glibc, which means
# Playwright's own bundled Chromium binary can be used directly in the
# application image — no system Chromium package needed.
#
# Published to Docker Hub as: lhotakj/firebird-python:<python_version>
# Example: lhotakj/firebird-python:3.13
# =============================================================================

ARG PYTHON_VERSION=3.13
ARG FIREBIRD_VERSION=5.0.3

# -----------------------------------------------------------------------------
# Stage 1: Builder — compile Firebird client-only from source
# -----------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim AS builder

ARG FIREBIRD_VERSION

# Build toolchain + Firebird build-time dependencies.
# libtomcrypt-dev: use Debian's system libtomcrypt instead of Firebird's
#   bundled copy — the bundled build requires libtool in a way that is
#   unreliable on Debian slim and causes "libtool: No such file or directory".
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libicu-dev \
        zlib1g-dev \
        wget \
        unzip \
        autoconf \
        automake \
        libtool \
        pkg-config \
        libtommath-dev \
        libtomcrypt-dev \
        libncurses-dev \
    && rm -rf /var/lib/apt/lists/*

# Download, configure and compile the Firebird client library.
# Notes:
#   --enable-client-only  → skip all server-side components
#   (no --with-builtin-tomcrypt) → use system libtomcrypt from libtomcrypt-dev
#   autogen.sh is called without args so it only runs autoreconf once;
#   ./configure is then called separately with our flags.
RUN mkdir -p /firebird-lib \
    && wget -q "https://github.com/FirebirdSQL/firebird/archive/refs/tags/v${FIREBIRD_VERSION}.tar.gz" \
    && tar xzf "v${FIREBIRD_VERSION}.tar.gz" \
    && cd "firebird-${FIREBIRD_VERSION}" \
    && chmod +x ./autogen.sh \
    && ./autogen.sh \
    && ./configure \
           --enable-client-only \
    && make -j"$(nproc)" \
    && cp ./gen/Release/firebird/lib/* /firebird-lib/

# -----------------------------------------------------------------------------
# Stage 2: Runtime — minimal Python Debian slim + Firebird client only
# -----------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim

ARG PYTHON_VERSION
ARG FIREBIRD_VERSION

LABEL maintainer="jarda@lhotak.net" \
      description="Python ${PYTHON_VERSION} Debian slim base image with Firebird ${FIREBIRD_VERSION} client library" \
      org.opencontainers.image.source="https://github.com/lhotakj/kinetiqo"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LD_LIBRARY_PATH=/usr/local/lib \
    FIREBIRD_LIB=/usr/local/lib/libfbclient.so

# Runtime-only system libraries required by the Firebird client, psycopg2,
# and the cron scheduler used by the application entrypoint.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libtommath1 \
        libtomcrypt1 \
        libpq5 \
        cron \
    && rm -rf /var/lib/apt/lists/* \
    && find /usr/share/doc     -mindepth 1 -maxdepth 1 -not -name "libc6" -exec rm -rf {} + 2>/dev/null || true \
    && rm -rf /usr/share/man /usr/share/groff /usr/share/info /usr/share/lintian

# Copy the compiled Firebird client shared library from the builder stage
COPY --from=builder /firebird-lib/ /usr/local/lib/

# Sanity check — fails the build if the library is missing
RUN ls -la /usr/local/lib/libfbclient.so* \
    && echo "Firebird client library installed successfully."


