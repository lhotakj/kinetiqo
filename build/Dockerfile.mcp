# =============================================================================
# Kinetiqo Application + MCP Server Image
# =============================================================================
# Runs Kinetiqo Web Dashboard (port 4444), Cron sync daemon, and the FastMCP
# Server (SSE transport on port 8000) concurrently in the same container.
#
# Uses the pre-built kinetiqo/firebird-python base image with system Chromium
# and Playwright, supporting all 35 MCP tools including Group E visual posters
# and infographics.
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Builder — install Python dependencies into an isolated prefix
# -----------------------------------------------------------------------------
FROM python:3.14-slim AS builder

WORKDIR /app
COPY requirements.txt .

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN pip install --only-binary=:all: --no-cache-dir --no-compile --prefix=/install -r requirements.txt \
    && find /install -type d -name "tests"       -exec rm -rf {} + 2>/dev/null || true \
    && find /install -type d -name "test"        -exec rm -rf {} + 2>/dev/null || true \
    && find /install -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true \
    && find /install -name "*.pyc" -delete \
    && find /install -name "*.pyo" -delete

# -----------------------------------------------------------------------------
# Stage 2: Runtime — application with web + cron + FastMCP enabled
# -----------------------------------------------------------------------------
FROM kinetiqo/firebird-python:3.14

ARG VERSION
LABEL maintainer="jarda@lhotak.net" \
      version=$VERSION \
      description="Kinetiqo fitness platform with integrated FastMCP server"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LOG_LEVEL=INFO \
    FULL_SYNC="" \
    FAST_SYNC="" \
    ENABLE_MCP=1 \
    MCP_PORT=8000 \
    MCP_HOST=0.0.0.0 \
    MCP_TRANSPORT=sse \
    PYTHONPATH=/usr/local/lib/python3.14/site-packages

WORKDIR /app

# Copy installed Python packages from builder
COPY --from=builder /install /usr/local

# Copy application source and entrypoint
COPY src ./
COPY build/entrypoint.sh ./

RUN chromium --version \
    && find /usr/local/lib -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true \
    && find /usr/local/lib -name "*.pyc" -delete 2>/dev/null || true \
    && find /usr/local/lib -name "*.pyo" -delete 2>/dev/null || true \
    && find /usr/local/lib -type d -name "tests" -exec rm -rf {} + 2>/dev/null || true \
    && find /usr/local/lib -type d -name "test"  -exec rm -rf {} + 2>/dev/null || true

EXPOSE 4444 8000

ENTRYPOINT ["/bin/bash", "entrypoint.sh"]
CMD ["gunicorn", "--bind", "0.0.0.0:4444", "--workers", "4", "--timeout", "180", "kinetiqo.web.app:app"]
