[run]
branch = True
source = src
omit =
    */tests/*
    */web/static/*
    */web/templates/*
    */development/*

[report]
show_missing = True
precision = 2
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
    raise ImportError

